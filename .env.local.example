# Coston2 RPC (Flare testnet). Public endpoint is fine for read; use a private RPC for production.
NEXT_PUBLIC_FLARE_RPC=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_FLARE_CHAIN_ID=114

# WalletConnect / Cloudflare (RainbowKit). Get yours at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WC_PROJECT_ID

# Faucet for Coston2 C2FLR + testnet FXRP
# https://faucet.flare.network/coston2

# Executor private key (Coston2 only — DO NOT use on mainnet).
# Fund via faucet with FLR. The executor must also be configured as an FXRP agent.
EXECUTOR_PK=
FASSET_AGENT_VAULT=
FASSET_MAX_MINTING_FEE_BIPS=500
FASSET_FXRP_FEE_ALLOWANCE=100000000

# FDC payment attestation returned by your XRPL/FDC worker after the
# underlying payment is confirmed. Provide one of these, never both.
FASSET_MINT_PROOF_JSON=
FASSET_MINT_PROOF_URL=

# Razorpay test keys (https://dashboard.razorpay.com/app/keys).
# Leave blank to use the built-in mock UPI screen.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
UPI_PSP=demo
UPI_DEMO_MODE=true

# Paddle Billing (sandbox first; Paddle UPI requires INR checkout and India address)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_TAX_CATEGORY=digital-goods

# Merchant details for the standards-based UPI QR/deep link.
# The demo VPA is not a real collection account; production requires a PSP-issued VPA.
UPI_VPA=your-merchant-vpa@bank
UPI_MERCHANT_NAME=Flare Remit
UPI_MCC=0000

# Safety rails (server-side, INR)
UPI_MIN_AMOUNT_INR=100
UPI_MAX_AMOUNT_INR=100000
UPI_MAX_SLIPPAGE_BPS=100

# Optional: an explicit public agent on Coston2. If empty, the helper queries
# the registry for AssetManagerFXRP and lists agents dynamically.
NEXT_PUBLIC_FXRP_AGENT=
